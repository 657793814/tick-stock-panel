# ===== TickFlow =====
# 留空或不填则启用 Free 试用模式(TickFlow.free()),仅能拿历史日 K 单股数据
TICKFLOW_API_KEY=

# ===== XTick(可选,数据源插件) =====
# 也可在「设置 → 数据源」卡片中直接填写; 写入 data/user_data/secrets.json(0600)。
# 上游仅支持 HTTP 且 token 走 query string, 请仅在可信网络使用。
XTICK_API_KEY=
# 默认 http://api.xtick.top; 上游目前无可用 HTTPS 端点。
XTICK_BASE_URL=

# ===== AI(可选,留空跳过 AI 功能) =====
AI_PROVIDER=openai_compat          # openai_compat | ollama
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_DAILY_TOKEN_BUDGET=500000

# ===== 图像模型(复盘海报,可选) =====
# 留空时接口地址/密钥回退到上面的文本 AI 配置,但模型必须单独指定。
# 兼容 OpenAI images/generations 接口,例如:
#   RunningHub: https://llm.runninghub.ai/v1
#   OpenAI:     https://api.openai.com/v1
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=1024x1536

# ===== Server =====
HOST=0.0.0.0
PORT=3018
LOG_LEVEL=INFO

# ===== Auth =====
# 首次启动时预置访问密码(可选)。公网服务器部署时填入,免去 SSH 端口转发设密码。
# 仅在尚未设置密码时生效(一次性初始化);设过后改密码请用页面 UI, 此处不再读取。
# 建议至少 6 位。.env 文件权限保持 600 且不要提交到 Git。
AUTH_PASSWORD=''

# Optional backend dependency extras for Docker and ./dev.sh / .\dev.ps1.
# Set to legacy-cpu on older CPUs without AVX2/FMA support.
# Combine with backtest as: legacy-cpu backtest
BACKEND_EXTRAS=

# ===== Data =====
# 源码运行按项目根目录解析；Docker 相对路径按 /app 解析。
# Docker 推荐显式设置 DATA_DIR=/app/data，并把宿主机目录挂载到同一路径。
DATA_DIR=./data
